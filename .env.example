DOMAIN=health.example.com
ENVIRONMENT=production
HEALTH_EXPORT_API_KEY=change-me-local-secret
HEALTH_EXPORT_READ_API_KEY=change-me-read-secret
HEALTH_EXPORT_SQLITE_PATH=/data/health_export.sqlite3
SESSION_SECRET=change-me-session-secret
DASHBOARD_PASSWORD=change-me-dashboard-password
# Preferred for production: replace DASHBOARD_PASSWORD with DASHBOARD_PASSWORD_HASH
# generated by `python -m macrofactor_scraper.hash_password`.
# DASHBOARD_PASSWORD_HASH=
MACROFACTOR_API_TIMEOUT_SECONDS=20

# On-demand AI analysis (optional — leave blank to disable the AI Insight feature)
ANTHROPIC_API_KEY=

# Garmin Connect sync (optional — leave blank to disable)
GARMIN_USERNAME=
GARMIN_PASSWORD=
# TOTP base32 secret for MFA accounts (find in your authenticator app setup)
GARMIN_MFA_SECRET=
# Path to store OAuth tokens so re-login is rare (defaults to ~/.garth)
GARMIN_TOKENSTORE=/data/garmin_tokens
# How often to sync in hours (default 6)
GARMIN_SYNC_INTERVAL_HOURS=6
